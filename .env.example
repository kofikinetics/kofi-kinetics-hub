# Copy this file to .env and fill in your values
# This file is safe to commit — .env is gitignored

# All API keys are stored in browser localStorage, not here.
# This file is just for reference.

# Instagram Graph API
# Get from: https://developers.facebook.com/docs/instagram-api/getting-started
VITE_IG_USER_ID=your_instagram_user_id
VITE_IG_TOKEN=your_long_lived_access_token

# TikTok Display API
# Get from: https://developers.tiktok.com
VITE_TIKTOK_TOKEN=your_tiktok_access_token

# Groq API — FREE, no credit card needed
# Get from: https://console.groq.com → API Keys → Create API Key
# Free tier: 14,400 requests/day — more than enough for personal use
VITE_GROQ_API_KEY=gsk_your_key_here
